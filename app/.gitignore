# Dependencies
node_modules/

# Build output (TanStack Start / Nitro / Vite)
.output/
dist/
.vite/

# Secrets — never commit
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*

# Wrangler / local D1 state.
#
# IMPORTANT: `.wrangler/state` holds the LOCAL development SQLite database
# created by `--local` migrations and `wrangler dev`. It is entirely separate
# from your real remote D1 databases and can be deleted at any time. Keeping it
# out of git avoids committing local data and avoids confusing it with
# production.
.wrangler/

# Generated Wrangler types are reproducible via `npm run cf-typegen`, but we
# commit worker-configuration.d.ts anyway so typecheck works on a fresh clone.

# TypeScript / editor
*.tsbuildinfo
.DS_Store
.idea/
.vscode/

# Logs
npm-debug.log*
*.log
