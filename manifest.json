{
  "name": "You.Ge",
  "short_name": "You.Ge",
  "description": "Everything for you",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "portrait",
  "screenshots": [
    {
      "src": "/img/logo/logo.jpeg",
      "sizes": "1024x1024",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "icons": [
    {
      "src": "/img/icon/icon.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/icon/icon.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "splash_screens": [
    {
      "src": "/img/logo/logo.jpeg",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "dir": "ltr",
  "lang": "en-US",
  "file_handlers": [
    {
      "action": "/handle-files",
      "accept": {
        "text/html": [".html"],
        "text/plain": [".txt"]
      }
    }
  ],
  "offline_enabled": true
}